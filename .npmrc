# Enable package lifecycle scripts.
enable-pre-post-scripts=true

# Hoist internal packages so tools relying on Node.js resolution
# (e.g. Storybook, Vite plugins, ESLint, etc.) can resolve them consistently.
public-hoist-pattern[]=*@vezham/*
public-hoist-pattern[]=*@vx-oss/*
public-hoist-pattern[]=*@vx-pro/*
