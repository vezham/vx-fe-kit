{
  "name": "chats",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/chats/src",
  "targets": {
    "hosts:setup": {},
    "routes:tanstack": {},
    "config-local-hostile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/chats",
        "commands": [
          "sudo pnpm exec hostile set localhost chats.vezham.local && sudo pnpm exec hostile set localhost chats.mock.vezham.local"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["category:app"]
}
