{
  "name": "ts-basic+react-query-mock",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ts-basic+react-query-mock/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ts-basic+react-query-mock",
        "commands": ["pnpm serve"],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ts-basic+react-query-mock",
        "commands": ["pnpm build"],
        "parallel": false
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ts-basic+react-query-mock",
        "commands": ["pnpm generate"],
        "parallel": false
      }
    }
  },
  "tags": ["category:app", "mock"]
}
