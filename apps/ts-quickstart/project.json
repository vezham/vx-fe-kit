{
  "name": "ts-quickstart",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ts-quickstart/src",
  "targets": {
    "config-local-hostile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ts-quickstart",
        "commands": [
          "sudo pnpm exec hostile set localhost ts-quickstart.vezham.local && sudo pnpm exec hostile set localhost ts-quickstart.mock.vezham.local"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["category:app"]
}
