{
  "name": "contact",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/contact/src",
  "targets": {
    "config-local-hostile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/contact",
        "commands": [
          "sudo pnpm exec hostile set localhost contact.vezham.local && sudo pnpm exec hostile set localhost contact.mock.vezham.local"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["category:app"]
}
