{
  "name": "clock",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/clock/src",
  "targets": {
    "config-local-hostile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/clock",
        "commands": [
          "sudo pnpm exec hostile set localhost clock.vezham.local && sudo pnpm exec hostile set localhost clock.mock.vezham.local"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["category:app"]
}
